{
    "compilerOptions": {
      "target": "es2022",
      "lib": ["es2023"],
      "module": "commonjs",
      "outDir": "./lib",
      "strict": true,
      "noImplicitAny": false,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "useUnknownInCatchVariables": false,
      "types": ["node", "mocha"]
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules"]
}
