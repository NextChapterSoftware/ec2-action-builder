{
  "name": "ec2-action-builder",
  "version": "1.13.0",
  "description": "GitHub action to provision self-hosted runners on AWS EC2 On-Demand and Spot instances",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc && ncc build lib/main.js",
    "format": "prettier --write src/**/*.ts",
    "format-check": "prettier --check '**/*.ts'",
    "lint": "eslint src/**/*.ts",
    "package": "ncc build --source-map --license licenses.txt",
    "test": "env TS_NODE_COMPILER_OPTIONS='{\"module\": \"commonjs\" }' DOTENV_CONFIG_PATH=.env mocha -r dotenv/config -r ts-node/register './tests/**/*.ts' -timeout 20000"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unblocked/ec2-action-builder.git"
  },
  "keywords": [
    "github-actions",
    "self-hosted-runner",
    "aws",
    "ec2",
    "spot-instances"
  ],
  "author": "",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/unblocked/ec2-action-builder/issues"
  },
  "homepage": "https://github.com/unblocked/ec2-action-builder#readme",
  "dependencies": {
    "@actions/core": "^2.0.3",
    "@actions/github": "^8.0.1",
    "@aws-sdk/client-ec2": "^3.1131.0",
    "@aws-sdk/client-pricing": "^3.1131.0",
    "@aws-sdk/client-sts": "^3.1131.0",
    "@smithy/types": "^4.18.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@faker-js/faker": "^6.3.1",
    "@types/chai": "^4.3.20",
    "@types/lodash": "^4.17.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.4",
    "@vercel/ncc": "^0.45.0",
    "chai": "^4.5.0",
    "dotenv": "^16.6.1",
    "mocha": "^11.8.0",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
